<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.autimate">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- Add this if you want to use offline voices -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutiMate"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".GoodbyeActivity"
            android:exported="false" />
        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AutiMate"> <!-- Changed from @style/Theme.AutiMate to this -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Login Activities -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".SignupActivity"
            android:exported="false" />
        <activity
            android:name=".ParentSignupActivity"
            android:exported="false" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" /> <!-- Child Management -->
        <activity
            android:name=".ChildSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".AddChildProfileActivity"
            android:exported="false" /> <!-- Home Activities -->
        <activity
            android:name=".ChildHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ChildProfileActivity"
            android:exported="false" />
        <activity
            android:name=".AccountActivity"
            android:exported="false" /> <!-- Routine Activities -->
        <activity
            android:name=".RoutineTimeActivity"
            android:exported="false" />
        <activity
            android:name=".StepDetailActivity"
            android:exported="false" />
        <activity
            android:name=".AddNewActivity"
            android:exported="false" />
        <activity
            android:name=".AddNewActivityActivity"
            android:exported="false" /> <!-- Game Activities -->
        <activity
            android:name=".GameSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".MixAndMatchGameActivity"
            android:exported="false" />
        <activity
            android:name=".DragDropGameActivity"
            android:exported="false" /> <!-- Reward & Progress -->
        <activity
            android:name=".RewardActivity"
            android:exported="false" />
        <activity
            android:name=".ProgressTrackerActivity"
            android:exported="false" />
        <activity
            android:name=".ThemeCustomizationActivity"
            android:exported="false" /> <!-- Completion Pages -->
        <activity
            android:name=".WellDoneActivity"
            android:exported="false" /> <!-- Utility -->
        <activity
            android:name=".SmoothPageTransformer"
            android:exported="false" />
        <activity
            android:name=".GoodbyeActivity"
            android:exported="false" />
    </application>

</manifest>