<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for light mode -->
    <style name="Theme.AutiMate" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/cream</item>
        <item name="colorPrimaryVariant">@color/beige</item>
        <item name="colorOnPrimary">@color/text_dark</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/soft_blue</item>
        <item name="colorSecondaryVariant">@color/khaki</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/cream</item>

        <!-- Window Background -->
        <item name="android:windowBackground">@color/cream</item>

        <!-- Text Colors -->
        <item name="android:textColor">@color/text_dark</item>

        <!-- Alert Dialog Button Text Colors -->
        <item name="android:buttonBarPositiveButtonStyle">@style/LightPositiveButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/LightNegativeButtonStyle</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/LightNeutralButtonStyle</item>
    </style>

    <!-- Light Mode Positive Button (YES, OK, ADD) -->
    <style name="LightPositiveButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Light Mode Negative Button (NO, CANCEL) -->
    <style name="LightNegativeButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Light Mode Neutral Button (Close) -->
    <style name="LightNeutralButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>