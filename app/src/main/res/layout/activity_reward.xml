<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:clickable="true"
                android:tint="@color/text_dark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="My Rewards"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:gravity="center" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ TOTAL POINTS"
                    android:textSize="12sp"
                    android:textColor="@color/light_brown"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/soft_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep going! You're doing great! 🥳"
                    android:textSize="12sp"
                    android:textColor="@color/light_brown"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You earned points! 🌟"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:id="@+id/tvRecentReward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Great job! You completed &quot;Brush Teeth.&quot;"
                        android:textSize="12sp"
                        android:textColor="@color/light_brown"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvRecentPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+5"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/khaki"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 Your Badges"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <GridLayout
                android:id="@+id/badgesGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:padding="16dp">

                <!-- First Star Badge -->
                <LinearLayout
                    android:id="@+id/badgeFirstStar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/badge_background_locked"
                    android:layout_margin="8dp">

                    <ImageView
                        android:id="@+id/ivBadgeFirstStar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/otter_star"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tvBadgeNameFirstStar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First Star"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complete 2 activities"
                        android:textSize="11sp"
                        android:textColor="@color/light_brown"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/badge1Progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/10"
                        android:textSize="10sp"
                        android:textColor="@color/khaki"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- One Roll Badge -->
                <LinearLayout
                    android:id="@+id/badgeOneRoll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/badge_background_locked"
                    android:layout_margin="8dp">

                    <ImageView
                        android:id="@+id/ivBadgeOneRoll"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/otter_fire"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tvBadgeNameOneRoll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="One Roll"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 days streak"
                        android:textSize="11sp"
                        android:textColor="@color/light_brown"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/badge2Progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/3"
                        android:textSize="10sp"
                        android:textColor="@color/khaki"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Super Helper Badge -->
                <LinearLayout
                    android:id="@+id/badgeSuperHelper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/badge_background_locked"
                    android:layout_margin="8dp">

                    <ImageView
                        android:id="@+id/ivBadgeSuperHelper"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/otter_strong"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tvBadgeNameSuperHelper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Super Helper"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complete all 5 activities"
                        android:textSize="11sp"
                        android:textColor="@color/light_brown"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/badge3Progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/5"
                        android:textSize="10sp"
                        android:textColor="@color/khaki"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Star Master Badge -->
                <LinearLayout
                    android:id="@+id/badgeStarMaster"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/badge_background_locked"
                    android:layout_margin="8dp">

                    <ImageView
                        android:id="@+id/ivBadgeStarMaster"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/otter_crown"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tvBadgeNameStarMaster"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Star Master"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Earn 50 points"
                        android:textSize="11sp"
                        android:textColor="@color/light_brown"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/badge4Progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/50"
                        android:textSize="10sp"
                        android:textColor="@color/khaki"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </GridLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Recent Rewards"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/recentRewardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnBackToHome"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="BACK TO HOMEPAGE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/soft_blue"
            app:cornerRadius="28dp" />

    </LinearLayout>

</ScrollView>