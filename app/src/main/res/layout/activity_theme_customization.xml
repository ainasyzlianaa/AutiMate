<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/cream"
            app:title="Customize Theme"
            app:titleTextColor="@color/text_dark"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/brown"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Main Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Header -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Choose Theme"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pick a theme you like!"
                            android:textSize="14sp"
                            android:textColor="@color/light_brown"
                            android:layout_marginBottom="24dp"/>

                        <!-- Light Theme Card -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/lightThemeCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#FFF9F2"
                            android:layout_marginBottom="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="16dp"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/ivLightIcon"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:src="@drawable/sun"
                                    android:layout_marginEnd="16dp"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvLightTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Light Mode"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_dark"/>

                                    <TextView
                                        android:id="@+id/tvLightDesc"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Bright and uplifting for daytime"
                                        android:textSize="12sp"
                                        android:textColor="@color/light_brown"/>

                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/lightCheckmark"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    app:srcCompat="@drawable/ic_check_circle"
                                    android:visibility="gone"/>

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- Dark Theme Card -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/darkThemeCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#2C2C2C"
                            android:layout_marginBottom="20dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="16dp"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/ivDarkIcon"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:src="@drawable/moon"
                                    android:layout_marginEnd="16dp"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvDarkTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Dark Mode"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"/>

                                    <TextView
                                        android:id="@+id/tvDarkDesc"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Soft and calm for nighttime"
                                        android:textSize="12sp"
                                        android:textColor="#D3D3D3"/>

                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/darkCheckmark"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    app:srcCompat="@drawable/ic_check_circle_white"
                                    android:visibility="gone"/>

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- Instruction Text -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tap a theme to select it, then click APPLY"
                            android:textSize="13sp"
                            android:textColor="@color/light_brown"
                            android:gravity="center"
                            android:layout_marginBottom="16dp"/>

                        <!-- Apply Button -->
                        <Button
                            android:id="@+id/btnApplyTheme"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="APPLY THEME"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/soft_blue"
                            app:cornerRadius="26dp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- SIDEBAR NAVIGATION MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_parent"
        app:menu="@menu/navigation_menu_parent"
        app:itemTextColor="@color/text_dark"
        app:itemIconTint="@color/light_brown"
        android:background="@color/white"/>

</androidx.drawerlayout.widget.DrawerLayout>