<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/cream"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/fixed_white"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <!-- Video Container with FIXED WHITE background -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginBottom="16dp"
                android:background="@color/fixed_white">

                <VideoView
                    android:id="@+id/welldoneVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Well Done!"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/soft_blue"
                android:textAlignment="center"
                android:layout_marginBottom="8dp"/>

            <!-- Message -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You've completed your routine!"
                android:textSize="16sp"
                android:textColor="@color/text_dark"
                android:textAlignment="center"
                android:layout_marginBottom="24dp"/>

            <!-- Points Earned -->
            <TextView
                android:id="@+id/tvPointsEarned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+5 POINTS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/soft_blue"
                android:layout_marginBottom="24dp"
                android:padding="8dp"
                android:background="@drawable/points_bg"/>

            <!-- View Reward Button -->
            <Button
                android:id="@+id/btnViewReward"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="VIEW REWARD"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/soft_blue"
                app:cornerRadius="24dp"
                android:layout_marginBottom="12dp"/>

            <!-- Back to Home Button -->
            <Button
                android:id="@+id/btnBackToHome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="BACK TO HOME"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:backgroundTint="@color/khaki"
                app:cornerRadius="24dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>