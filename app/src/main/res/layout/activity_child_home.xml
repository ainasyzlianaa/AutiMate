<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOOLBAR WITH 3-LINE MENU -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/cream"
            app:title=""
            app:titleTextColor="@color/text_dark"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/brown"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ===== HERO HEADER SECTION ===== -->
                <!-- White banner with greeting left, video right -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingStart="24dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp"
                        android:gravity="center_vertical">

                        <!-- Greeting text (left) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hello,"
                                android:textSize="15sp"
                                android:textColor="#8B6347"/>

                            <TextView
                                android:id="@+id/childTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Welcome back! 👋"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="#3B1F0A"/>

                            <TextView
                                android:id="@+id/childSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Let's have a great day!"
                                android:textSize="13sp"
                                android:textColor="#8B6347"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                        <!-- Video Container with WHITE background (FIXED for dark mode) -->
                        <FrameLayout
                            android:layout_width="130dp"
                            android:layout_height="160dp"
                            android:layout_marginEnd="0dp"
                            android:background="#FFFFFF">

                            <VideoView
                                android:id="@+id/mascotVideo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center" />

                        </FrameLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ===== STATS CARD (Progress + Streak) ===== -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#F0E6D8"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="-20dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center">

                        <!-- Progress side -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today's Progress"
                                android:textSize="12sp"
                                android:textColor="@color/light_brown"/>

                            <TextView
                                android:id="@+id/progressStars"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⭐⭐⭐⭐☆"
                                android:textSize="20sp"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:id="@+id/tvProgressText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4 / 5 Activities"
                                android:textSize="11sp"
                                android:textColor="@color/light_brown"
                                android:layout_marginTop="2dp"/>

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="50dp"
                            android:background="@color/divider"
                            android:layout_marginHorizontal="16dp"/>

                        <!-- Streak side -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Streak"
                                android:textSize="12sp"
                                android:textColor="@color/light_brown"/>

                            <TextView
                                android:id="@+id/tvStreak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔥 7"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="#FF6B35"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Days in a row!"
                                android:textSize="11sp"
                                android:textColor="@color/light_brown"
                                android:layout_marginTop="2dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ===== SECTION LABEL ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What would you like to do?"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"/>

                <!-- ===== ROUTINE TIME CARD (light blue tint) ===== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRoutine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#E0F2FF"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <!-- Icon image in white circle -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#FFFFFF">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:src="@drawable/routine"
                                android:scaleType="fitCenter"/>

                        </androidx.cardview.widget.CardView>

                        <!-- Title + subtitle -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ROUTINE TIME"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/soft_blue"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Follow your daily schedule"
                                android:textSize="12sp"
                                android:textColor="#5A8FAA"
                                android:layout_marginTop="3dp"/>

                        </LinearLayout>

                        <!-- Arrow button (blue circle) -->
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:text="→"
                            android:textSize="20sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@drawable/circle_blue_bg"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ===== PLAY GAMES CARD (light green tint) ===== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardGame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#DFFADF"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#FFFFFF">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:src="@drawable/game"
                                android:scaleType="fitCenter"/>

                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PLAY GAMES"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="#2DA84A"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fun and learning activities"
                                android:textSize="12sp"
                                android:textColor="#5AAA6E"
                                android:layout_marginTop="3dp"/>

                        </LinearLayout>

                        <!-- Arrow button (green circle) -->
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:text="→"
                            android:textSize="20sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@drawable/circle_green_bg"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ===== REWARDS CARD (light purple tint) ===== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRewards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#EDE0FF"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#FFFFFF">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:src="@drawable/reward"
                                android:scaleType="fitCenter"/>

                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REWARDS"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="#7B4FCC"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="See your stars and badges"
                                android:textSize="12sp"
                                android:textColor="#9B7FCC"
                                android:layout_marginTop="3dp"/>

                        </LinearLayout>

                        <!-- Arrow button (purple circle) -->
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:text="→"
                            android:textSize="20sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@drawable/circle_purple_bg"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ===== ENCOURAGEMENT BANNER ===== -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/beige"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💫"
                            android:textSize="24sp"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="You're doing great! Keep going!"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- SIDEBAR NAVIGATION MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_child"
        app:menu="@menu/navigation_menu_parent"
        app:itemTextColor="@color/text_dark"
        app:itemIconTint="@color/light_brown"
        android:background="@color/white"/>

</androidx.drawerlayout.widget.DrawerLayout>