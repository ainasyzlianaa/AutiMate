<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Header with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:clickable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Child Profile"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:gravity="center"/>

            <View android:layout_width="40dp" android:layout_height="40dp"/>

        </LinearLayout>

        <!-- Child Name Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Child Name"
            android:textSize="14sp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"
            android:layout_gravity="start"/>

        <EditText
            android:id="@+id/etChildName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your child name"
            android:padding="16dp"
            android:backgroundTint="@color/khaki"
            android:layout_marginBottom="16dp"/>

        <!-- Age Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Age"
            android:textSize="14sp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"
            android:layout_gravity="start"/>

        <EditText
            android:id="@+id/etAge"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your child age"
            android:padding="16dp"
            android:backgroundTint="@color/khaki"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <!-- Gender Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gender"
            android:textSize="14sp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"
            android:layout_gravity="start"/>

        <RadioGroup
            android:id="@+id/radioGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Male"
                android:textColor="@color/text_dark"
                android:layout_marginEnd="32dp"/>

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Female"
                android:textColor="@color/text_dark"/>

        </RadioGroup>

        <!-- Character Selection Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a character for your child"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="16dp"
            android:layout_gravity="start"/>

        <!-- Row 1 - Animals -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾 Animals"
            android:textSize="13sp"
            android:textColor="@color/light_brown"
            android:layout_marginBottom="8dp"
            android:layout_gravity="start"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:weightSum="4">

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarCat"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🐱"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarDog"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🐶"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarRabbit"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🐰"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarBear"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🐻"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Row 2 - More Animals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:weightSum="4">

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarPanda"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🐼"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarFox"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🦊"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarPenguin"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🐧"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarOwl"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🦉"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Row 3 - Fantasy Characters -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Fantasy"
            android:textSize="13sp"
            android:textColor="@color/light_brown"
            android:layout_marginBottom="8dp"
            android:layout_gravity="start"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:weightSum="4">

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarUnicorn"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🦄"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarDragon"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🐉"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarAlien"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="👽"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarRobot"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🤖"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Row 4 - Cute Emojis -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌟 Cute"
            android:textSize="13sp"
            android:textColor="@color/light_brown"
            android:layout_marginBottom="8dp"
            android:layout_gravity="start"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:weightSum="4">

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarStar"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="⭐"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarHeart"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="❤️"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarSmile"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="😊"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/avatarSparkle"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:cardCornerRadius="35dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="✨"
                    android:textSize="40sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Selected Avatar Display -->
        <TextView
            android:id="@+id/tvSelectedAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected: 🐱 Cat"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/soft_blue"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:padding="8dp"
            android:background="@drawable/selected_bg"/>

        <!-- Next Button -->
        <Button
            android:id="@+id/btnAddChild"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="NEXT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/soft_blue"
            app:cornerRadius="28dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>