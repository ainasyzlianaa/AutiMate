<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/cream"
            app:title="Child's Profile"
            app:titleTextColor="@color/text_dark"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/brown"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Profile Picture Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnChangePhoto"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        app:cardCornerRadius="70dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="@color/white"
                        android:clickable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/profileImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"/>

                            <TextView
                                android:id="@+id/profileIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="👧"
                                android:textSize="60sp"
                                android:gravity="center"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Edit Profile"
                                android:textSize="12sp"
                                android:textColor="@color/text_dark"
                                android:background="@drawable/card_background"
                                android:padding="6dp"
                                android:layout_gravity="bottom|center"
                                android:layout_marginBottom="10dp"/>

                        </FrameLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- View Mode -->
                <LinearLayout
                    android:id="@+id/viewMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:layout_marginBottom="20dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- Name -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Name"
                                android:textSize="14sp"
                                android:textColor="@color/light_brown"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Not set"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark"
                                android:layout_marginBottom="16dp"/>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/divider"/>

                            <!-- Gender -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gender"
                                android:textSize="14sp"
                                android:textColor="@color/light_brown"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp"/>
                            <TextView
                                android:id="@+id/tvGender"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Not set"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark"
                                android:layout_marginBottom="16dp"/>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/divider"/>

                            <!-- Age -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Age"
                                android:textSize="14sp"
                                android:textColor="@color/light_brown"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp"/>
                            <TextView
                                android:id="@+id/tvAge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Not set"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark"
                                android:layout_marginBottom="16dp"/>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/divider"/>

                            <!-- Date of Birth -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date of Birth"
                                android:textSize="14sp"
                                android:textColor="@color/light_brown"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp"/>
                            <TextView
                                android:id="@+id/tvDob"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Not set"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Edit Mode -->
                <LinearLayout
                    android:id="@+id/editMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="20dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- Name -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Name"
                                android:textSize="14sp"
                                android:textColor="@color/light_brown"
                                android:textStyle="bold"/>
                            <EditText
                                android:id="@+id/etName"
                                android:layout_width="match_parent"
                                android:layout_height="55dp"
                                android:hint="Enter name"
                                android:padding="12dp"
                                android:background="@drawable/rounded_input_bg"
                                android:textSize="16sp"
                                android:layout_marginBottom="16dp"/>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/divider"/>

                            <!-- Gender -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gender"
                                android:textSize="14sp"
                                android:textColor="@color/light_brown"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp"/>
                            <RadioGroup
                                android:id="@+id/radioGender"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">
                                <RadioButton
                                    android:id="@+id/rbBoy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Boy"
                                    android:textSize="16sp"
                                    android:layout_marginEnd="24dp"
                                    android:buttonTint="@color/soft_blue"/>
                                <RadioButton
                                    android:id="@+id/rbGirl"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Girl"
                                    android:textSize="16sp"
                                    android:buttonTint="@color/soft_pink"/>
                            </RadioGroup>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/divider"
                                android:layout_marginTop="16dp"/>

                            <!-- Age -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Age"
                                android:textSize="14sp"
                                android:textColor="@color/light_brown"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp"/>
                            <EditText
                                android:id="@+id/etAge"
                                android:layout_width="match_parent"
                                android:layout_height="55dp"
                                android:hint="Enter age (5-12)"
                                android:inputType="number"
                                android:padding="12dp"
                                android:background="@drawable/rounded_input_bg"
                                android:textSize="16sp"
                                android:layout_marginBottom="16dp"/>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/divider"/>

                            <!-- Date of Birth -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date of Birth"
                                android:textSize="14sp"
                                android:textColor="@color/light_brown"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp"
                                android:weightSum="3">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:layout_marginEnd="8dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Day"
                                        android:textSize="12sp"
                                        android:textColor="@color/light_brown"
                                        android:layout_marginBottom="4dp"/>

                                    <Spinner
                                        android:id="@+id/spinnerDay"
                                        android:layout_width="match_parent"
                                        android:layout_height="50dp"
                                        android:background="@drawable/rounded_input_bg"
                                        android:padding="8dp"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:layout_marginEnd="8dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Month"
                                        android:textSize="12sp"
                                        android:textColor="@color/light_brown"
                                        android:layout_marginBottom="4dp"/>

                                    <Spinner
                                        android:id="@+id/spinnerMonth"
                                        android:layout_width="match_parent"
                                        android:layout_height="50dp"
                                        android:background="@drawable/rounded_input_bg"
                                        android:padding="8dp"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Year"
                                        android:textSize="12sp"
                                        android:textColor="@color/light_brown"
                                        android:layout_marginBottom="4dp"/>

                                    <Spinner
                                        android:id="@+id/spinnerYear"
                                        android:layout_width="match_parent"
                                        android:layout_height="50dp"
                                        android:background="@drawable/rounded_input_bg"
                                        android:padding="8dp"/>

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Emoji Avatar Selection Section -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Choose an Emoji Avatar"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark"
                                android:layout_marginTop="24dp"
                                android:layout_marginBottom="8dp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Pick an avatar that your child loves!"
                                android:textSize="13sp"
                                android:textColor="@color/light_brown"
                                android:layout_marginBottom="16dp"/>

                            <!-- Avatar Grid Row 1 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="4"
                                android:layout_marginBottom="12dp">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarCat"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🐱"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarDog"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🐶"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarRabbit"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🐰"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarBear"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🐻"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                            </LinearLayout>

                            <!-- Avatar Grid Row 2 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="4"
                                android:layout_marginBottom="12dp">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarPanda"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🐼"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarFox"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🦊"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarPenguin"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🐧"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarOwl"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🦉"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                            </LinearLayout>

                            <!-- Avatar Grid Row 3 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="4"
                                android:layout_marginBottom="12dp">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarUnicorn"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🦄"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarDragon"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🐉"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarAlien"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="👽"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarRobot"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="🤖"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                            </LinearLayout>

                            <!-- Avatar Grid Row 4 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="4"
                                android:layout_marginBottom="12dp">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarStar"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="⭐"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarHeart"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="❤️"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarSmile"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="😊"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/avatarSparkle"
                                    android:layout_width="0dp"
                                    android:layout_height="65dp"
                                    android:layout_weight="1"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="3dp"
                                    app:cardBackgroundColor="@color/white"
                                    android:clickable="true"
                                    android:foreground="?android:attr/selectableItemBackground">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="✨"
                                        android:textSize="36sp"
                                        android:gravity="center"/>

                                </androidx.cardview.widget.CardView>

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="❤️ You can change the avatar anytime in your child's profile."
                                android:textSize="12sp"
                                android:textColor="@color/light_brown"
                                android:gravity="center"
                                android:layout_marginTop="8dp"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Action Buttons -->
                <Button
                    android:id="@+id/btnEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="EDIT PROFILE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/soft_blue"
                    android:layout_marginTop="16dp"
                    app:cornerRadius="12dp"/>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="LOGOUT"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:backgroundTint="@color/khaki"
                    android:layout_marginTop="12dp"
                    app:cornerRadius="12dp"/>

                <!-- Edit Mode Buttons -->
                <LinearLayout
                    android:id="@+id/editButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnCancel"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:text="CANCEL"
                        android:textColor="@color/text_dark"
                        android:backgroundTint="@color/khaki"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="12dp"/>

                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:text="SAVE"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/soft_blue"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="12dp"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- SIDEBAR NAVIGATION MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_parent"
        app:menu="@menu/navigation_menu_parent"
        app:itemTextColor="@color/text_dark"
        app:itemIconTint="@color/light_brown"
        android:background="@color/white"/>

</androidx.drawerlayout.widget.DrawerLayout>