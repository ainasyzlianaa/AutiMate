<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/cream"
            app:title=""
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/brown"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Activity"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="16dp"/>

                <!-- Current Activities Section -->
                <TextView
                    android:id="@+id/tvCurrentActivities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Activities"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/soft_blue"
                    android:layout_marginBottom="12dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:id="@+id/activityListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"/>

                </androidx.cardview.widget.CardView>

                <!-- Add Button -->
                <Button
                    android:id="@+id/btnAddNewActivity"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="+ ADD NEW ACTIVITY"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/soft_blue"
                    app:cornerRadius="28dp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_parent"
        app:menu="@menu/navigation_menu_parent"
        app:itemTextColor="@color/text_dark"
        app:itemIconTint="@color/light_brown"
        android:background="@color/white"/>

</androidx.drawerlayout.widget.DrawerLayout>