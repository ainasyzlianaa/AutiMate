<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/cream"
    android:padding="16dp">

    <!-- White Card View Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <!-- Video Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <VideoView
                    android:id="@+id/stepVideo"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_gravity="center"/>

                <ProgressBar
                    android:id="@+id/videoProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"/>

            </FrameLayout>

            <!-- Step Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/stepNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/soft_blue"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/stepInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Take a toothbrush"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:gravity="center"
                    android:lineSpacingExtra="8dp"/>

                <!-- DONE Button (appears on last step) -->
                <Button
                    android:id="@+id/btnDone"
                    android:layout_width="200dp"
                    android:layout_height="50dp"
                    android:text="FINISH"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/soft_blue"
                    app:cornerRadius="25dp"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Swipe Hint (hidden on last step) -->
    <TextView
        android:id="@+id/tvSwipeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👆 Swipe to continue"
        android:textSize="12sp"
        android:textColor="@color/light_brown"
        android:layout_marginBottom="8dp"
        android:alpha="0.7"/>

</LinearLayout>